[Unit]
Description=Dash RPi Display Client
After=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/dash-rpi

# ESSENCIAL
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

ExecStartPre=/bin/chvt 1
ExecStart=/usr/local/bin/dash-rpi-start.sh

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
